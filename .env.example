# FoodRush X Environment Configuration Template
PORT=5000
NODE_ENV=development

# JWT Secret for Session & Role Authentication
JWT_SECRET=your_jwt_secret_token_change_in_production

# AI Concierge Provider (Optional - When unset, high-performance deterministic engine is used)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Settings (Defaults to file-persisted JSON/SQLite store)
DATABASE_URL=file:./server/data/db.json

# Simulated Dispatch Center
DISPATCH_SIMULATION_ENABLED=true
